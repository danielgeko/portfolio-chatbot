# Copy this file to .env.local and fill in your own values.
# .env.local is gitignored — your real key never gets committed.

ANTHROPIC_API_KEY=

# Rate limiting (Upstash Redis). Optional locally — if unset, rate limiting is
# skipped and the app still works. REQUIRED before going public so visitors
# can't run up your API bill. Create a free DB at upstash.com, then paste its
# REST URL + token here (and set the same vars on Vercel).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Only needed in production (Vercel) once you're bundling content/ per the
# "Content Privacy & Deployment" section of the plan. Leave unset for local dev.
# PORTFOLIO_CONTENT_JSON=
